:AssetAdministrationShell rdf:type owl:Class ;
                            rdfs:subClassOf [ rdf:type owl:Restriction ;
      owl:onProperty :hasAssetInformation ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass :AssetInformation
    ],
                                            [ rdf:type owl:Restriction ;
      owl:onProperty :hasX_3DX ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass :X_3DX
    ],
                                            [ rdf:type owl:Restriction ;
      owl:onProperty :hasBDS ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass :BDS
    ],
                                            [ rdf:type owl:Restriction ;
      owl:onProperty :hasXRAY ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass :XRAY
    ],
                                            [ rdf:type owl:Restriction ;
      owl:onProperty :hasSP ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass :SP
    ],
                                            [ rdf:type owl:Restriction ;
      owl:onProperty :hasVCDP ;
      owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
      owl:onClass :VCDP
    ],
                                            [ rdf:type owl:Restriction ;
      owl:onProperty :hasMFG ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass :MFG
    ],
                                            [ rdf:type owl:Restriction ;
      owl:onProperty :hasCRM ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass :CRM
    ] .

:id rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
  rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( :AssetAdministrationShell :Submodel ) ] ;
  rdfs:range xsd:string .
:idShort rdf:type owl:DatatypeProperty ;
  rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( :AssetAdministrationShell :Property :Submodel ) ] ;
  rdfs:range xsd:string .
:name rdf:type owl:DatatypeProperty ; rdfs:domain :SpecificAssetId ; rdfs:range xsd:string .
:value rdf:type owl:DatatypeProperty ;
  rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( :Property :SpecificAssetId ) ] ;
  rdfs:range rdfs:Literal .
:valueType rdf:type owl:DatatypeProperty ; rdfs:domain :SpecificAssetId ; rdfs:range xsd:string .
:globalAssetId rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
  rdfs:domain :AssetInformation ; rdfs:range xsd:string .

:classifies rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: BatteryCategory classifies BatteryChemistry

:defines rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: BatteryMass defines BatteryCategory

:references rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: ComponentPartNumbers references BatteryCategory

:determines rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: BatteryChemistry determines CriticalRawMaterials

:composedOf rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: MaterialsCathode composedOf CriticalRawMaterials

# Enrichment: MaterialsAnode composedOf CriticalRawMaterials

# Enrichment: MaterialsElectrolyte composedOf CriticalRawMaterials

:requires rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: HazardousSubstances requires SafetyMeasures

:derivedFrom rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: CertifiedUsableBatteryEnergy derivedFrom NominalVoltage

:definesUpperBound rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: MaximumVoltage definesUpperBound NominalVoltage

:definesLowerBound rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: MinimumVoltage definesLowerBound NominalVoltage

:influences rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: PowerFade influences MaximumPermittedBatteryPower

# Enrichment: RoundTripEfficiencyAtHalfCycleLife derivedFrom InitialRoundTripEnergyEfficiency

# Enrichment: EnergyEfficiencyFade influences ExpectedLifetimeYears

# Enrichment: TemperatureRangeIdleStateLowerBoundary definesLowerBound TemperatureRangeIdleStateUpperBoundary

:validates rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: TestReportComplianceResults validates BatteryCategory

# Enrichment: CarbonFootprintLabel classifies AbsoluteBatteryCarbonFootprint

# Enrichment: CarbonFootprintPerformanceClass derivedFrom CarbonFootprintStudyUrl

:certifies rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: EuDeclarationOfConformity certifies BatteryCategory

:mitigates rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: ExtinguishingAgent mitigates ImpactOnEnvironmentHumanHealthSafety

# Enrichment: RatedCapacity defines BatteryCategory

# Enrichment: RemainingCapacity derivedFrom CapacityFade

# Enrichment: RemainingUsableBatteryEnergy derivedFrom RemainingCapacity

:affects rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: StateOfCharge affects RemainingPowerCapability

# Enrichment: NominalPowerToEnergyRatio derivedFrom RemainingUsableBatteryEnergy

# Enrichment: RemainingRoundTripEnergyEfficiency derivedFrom InitialRoundTripEnergyEfficiency

:influencedBy rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: ExpectedLifetimeCycles influencedBy FullChargeDischargeCycles

:aggregates rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: EnergyThroughput aggregates CapacityThroughput

# Enrichment: TemperatureInformation influences StateOfCharge

# Enrichment: TimeInExtremeTemperaturesAboveBoundary influences CapacityFade

# Enrichment: TimeChargingInExtremeTemperaturesBelowBoundary influences EnergyEfficiencyFade

:reduces rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: DeepDischargeEvents reduces ExpectedLifetimeCycles

# Enrichment: OverchargeEvents reduces ExpectedLifetimeCycles

:occurredOn rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: RecordHistoryDate occurredOn VCDP

:definesLifecycleStart rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: ManufacturingDate definesLifecycleStart BatteryIdentifier

:manufacturedBy rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: ManufacturerIdentifierAndInformation manufacturedBy BatteryIdentifier

:locatedAt rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: ManufacturingPlace locatedAt ManufacturerIdentifierAndInformation

# Enrichment: VehicleMfgDate definesLifecycleStart VehicleProgramName

# Enrichment: DateOfBatteryDelivery definesLifecycleStart BatteryIdentifier

:definesWarranty rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: WarrantyPeriodOfBattery definesWarranty BatteryIdentifier

:guides rdf:type owl:ObjectProperty ; rdfs:domain :Property ; rdfs:range :Property .

# Enrichment: DismantlingInformationManuals guides SparePartsInformation

# Enrichment: AccidentInformation influences WarrantyPeriodOfBattery
